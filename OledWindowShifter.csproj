<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.2.0</Version>
		<FileVersion>1.2.0.0</FileVersion>
		<AssemblyVersion>$(FileVersion)</AssemblyVersion>

		<!-- Prevents .NET from appending the Git commit hash (+a1b2c3d) to Product Version -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<!-- Metadata shown in Windows File Explorer → Properties → Details -->
		<Product>OLED Window Shifter</Product>
		<Authors>Nikhil S. Shringarpurey</Authors>
		<Description>Periodically shifts windows to reduce OLED burn-in.</Description>
		<Copyright>Copyright © 2026 Nikhil S. Shringarpurey. All rights reserved.</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<ApplicationIcon>Assets\tray.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="NativeMethods.txt" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\tray.ico" />
	</ItemGroup>

	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
