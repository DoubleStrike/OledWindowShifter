<Window x:Class="OledWindowShifter.UI.WarningOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">

    <Grid>
        <!-- Subtle glowing border around the target window -->
        <Border x:Name="OutlineBorder"
                BorderBrush="#CC00B4D8"
                BorderThickness="3"
                CornerRadius="6"
                Background="#1400B4D8" />

        <!-- Shrinking countdown bar along the top edge -->
        <Border Height="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="#FF00E5FF"
                CornerRadius="2"
                x:Name="CountdownBar" />
    </Grid>
</Window>
