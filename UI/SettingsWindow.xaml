<Window x:Class="OledWindowShifter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLED Window Shifter — Settings"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shift interval (seconds):" VerticalAlignment="Center" Margin="0,0,0,10" />
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" Margin="0,0,0,10" Padding="4,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Warning indicator (seconds):" VerticalAlignment="Center" Margin="0,0,0,10" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="WarningBox" Margin="0,0,0,10" Padding="4,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Max shift distance (pixels):" VerticalAlignment="Center" Margin="0,0,0,10" />
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ShiftPixelsBox" Margin="0,0,0,10" Padding="4,2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Animation duration (ms):" VerticalAlignment="Center" />
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AnimDurationBox" Padding="4,2" />
        </Grid>

        <CheckBox x:Name="AllowStationaryCursorCheck"
          Margin="0,14,0,0"
          Content="Allow shifting window under stationary cursor&#x0a;(aborts if cursor moves in final 25% or enters window)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="75" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="75" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
